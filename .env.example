# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Execution Mode: "demo" (instant responsive mode for live demos) or "local_agriparam" (runs bharatgenai/AgriParam locally)
EXECUTION_MODE=demo

# Optional Hugging Face Token (required if downloading gated weights or querying private HF endpoints)
HF_TOKEN=

# Model Identifiers
AGRIPARAM_MODEL_ID=bharatgenai/AgriParam
INDICTRANS_INDIC_EN_MODEL_ID=ai4bharat/indictrans2-indic-en-dist-200M
INDICTRANS_EN_INDIC_MODEL_ID=ai4bharat/indictrans2-en-indic-dist-200M
EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Storage Paths
CHROMA_PERSIST_DIRECTORY=./data/chroma
ADVISORY_DOCS_DIRECTORY=./data/advisories
